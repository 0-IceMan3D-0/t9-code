<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t3w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/t3w_bg"
  android:orientation="vertical"
  android:paddingStart="10dp"
  android:paddingTop="10dp"
  android:paddingEnd="10dp"
  android:paddingBottom="8dp">
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="28dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp">
    <ImageView
      android:id="@+id/t3w_icon"
      android:layout_width="18dp"
      android:layout_height="18dp"
      android:layout_marginEnd="8dp"
      android:importantForAccessibility="no" />
    <TextView
      style="@style/T3wHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="Usage today" />
  </LinearLayout>
  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:baselineAligned="true"
    android:orientation="horizontal"
    android:paddingStart="4dp">
    <TextView
      android:id="@+id/t3w_tokens"
      style="@style/T3wBig"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="–" />
    <TextView
      android:id="@+id/t3w_unit"
      style="@style/T3wSecondary"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginStart="6dp"
      android:text="tokens" />
  </LinearLayout>
  <TextView
    android:id="@+id/t3w_busiest"
    style="@style/T3wSecondary"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="2dp"
    android:maxLines="2"
    android:paddingStart="4dp"
    android:singleLine="false"
    android:text="@string/t3w_loading" />
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />
  <TextView
    android:id="@+id/t3w_stamp"
    style="@style/T3wStamp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone" />
</LinearLayout>
