<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t3w_root"
  android:background="@drawable/t3w_bg"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:gravity="center"
  android:orientation="horizontal"
  android:padding="4dp">
  <FrameLayout
    android:id="@+id/t3w_memory"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/t3w_row_bg">
    <FrameLayout
      android:layout_width="64dp"
      android:layout_height="72dp"
      android:layout_gravity="center">
      <ImageView
        android:id="@+id/t3w_memory_arc"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no" />
      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/t3w_ic_cpu" />
      <TextView
        android:id="@+id/t3w_memory_label"
        style="@style/T3wGaugeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="–" />
    </FrameLayout>
  </FrameLayout>
  <FrameLayout
    android:id="@+id/t3w_threads"
    android:layout_width="0dp"
    android:layout_height="match_parent"
    android:layout_weight="1"
    android:background="@drawable/t3w_row_bg">
    <FrameLayout
      android:layout_width="64dp"
      android:layout_height="72dp"
      android:layout_gravity="center">
      <ImageView
        android:id="@+id/t3w_threads_arc"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:importantForAccessibility="no" />
      <ImageView
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="18dp"
        android:importantForAccessibility="no"
        android:src="@drawable/t3w_ic_messages" />
      <TextView
        android:id="@+id/t3w_threads_label"
        style="@style/T3wGaugeLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:text="–" />
    </FrameLayout>
  </FrameLayout>
</LinearLayout>
