<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t3w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/t3w_bg"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="12dp"
  android:paddingEnd="10dp">
  <ImageView
    android:id="@+id/t3w_icon"
    android:layout_width="28dp"
    android:layout_height="28dp"
    android:layout_marginEnd="10dp"
    android:importantForAccessibility="no" />
  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">
    <TextView
      style="@style/T3wHeader"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:text="This phone" />
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:gravity="center_vertical"
      android:orientation="horizontal">
      <ImageView
        android:id="@+id/t3w_status_dot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginEnd="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/t3w_dot_idle" />
      <TextView
        android:id="@+id/t3w_status"
        style="@style/T3wSecondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
    </LinearLayout>
  </LinearLayout>
  <TextView
    android:id="@+id/t3w_start"
    style="@style/T3wButton.Primary"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_marginStart="8dp"
    android:text="Start"
    android:visibility="gone" />
  <TextView
    android:id="@+id/t3w_stop"
    style="@style/T3wButton.Plain"
    android:layout_width="wrap_content"
    android:layout_height="34dp"
    android:layout_marginStart="8dp"
    android:text="Stop"
    android:visibility="gone" />
</LinearLayout>
