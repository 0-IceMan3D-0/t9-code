<?xml version="1.0" encoding="utf-8"?>
<!-- Glass card: translucent fill, a light top sheen and a hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/t3w_surface" />
      <corners android:radius="22dp" />
    </shape>
  </item>
  <item android:bottom="40dp">
    <shape android:shape="rectangle">
      <gradient android:angle="270" android:startColor="@color/t3w_sheen" android:endColor="#00FFFFFF" />
      <corners android:topLeftRadius="22dp" android:topRightRadius="22dp" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <stroke android:width="1dp" android:color="@color/t3w_edge" />
      <corners android:radius="22dp" />
    </shape>
  </item>
</layer-list>
