    <TextView
      android:id="@+id/t3w_empty"
      style="@style/T3wSecondary"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:gravity="center"
      android:text="@string/t3w_loading" />
  </FrameLayout>
    <TextView
      android:id="@+id/t3w_stamp"
      style="@style/T3wStamp"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:visibility="gone" />
</LinearLayout>
