<?xml version="1.0" encoding="utf-8"?>
<!-- Generated row slots: RemoteViews has no adapter-free list, and six rows fill a 4x4 widget. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  android:id="@+id/t3w_root"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/t3w_bg"
  android:orientation="vertical"
  android:paddingStart="10dp"
  android:paddingTop="10dp"
  android:paddingEnd="10dp"
  android:paddingBottom="8dp">
    <LinearLayout
      android:id="@+id/t3w_header"
      android:layout_width="match_parent"
      android:layout_height="28dp"
      android:background="@drawable/t3w_row_bg"
      android:gravity="center_vertical"
      android:orientation="horizontal"
      android:paddingStart="4dp"
      android:paddingEnd="6dp">
      <ImageView
        android:id="@+id/t3w_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:importantForAccessibility="no" />
      <TextView
        android:id="@+id/t3w_title"
        style="@style/T3wHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />
      <TextView
        android:id="@+id/t3w_count"
        style="@style/T3wSecondary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" />
    </LinearLayout>
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1">
    <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical">
      <LinearLayout
        android:id="@+id/t3w_row0"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/t3w_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">
        <ImageView
          android:id="@+id/t3w_row0_dot"
          android:layout_width="8dp"
          android:layout_height="8dp"
          android:layout_marginEnd="10dp"
          android:importantForAccessibility="no"
          android:src="@drawable/t3w_dot_idle" />
        <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical">
          <TextView
            android:id="@+id/t3w_row0_title"
            style="@style/T3wTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
          <TextView
            android:id="@+id/t3w_row0_sub"
            style="@style/T3wSecondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView
          android:id="@+id/t3w_row0_badge"
          style="@style/T3wBadge"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:text="Needs you"
          android:visibility="gone" />
        <TextView
          android:id="@+id/t3w_row0_status"
          style="@style/T3wSecondary"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="8dp"
          android:visibility="gone" />
      </LinearLayout>
      <LinearLayout
        android:id="@+id/t3w_row1"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/t3w_row_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">
        <ImageView
