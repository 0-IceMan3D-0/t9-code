<?xml version="1.0" encoding="utf-8"?>
<!-- A plain neutral card that follows light and dark mode; Android 12+ takes its neutrals from the wallpaper (values-v31). -->
<resources>
  <color name="t3w_surface">#FFF7F7F8</color>
  <color name="t3w_text">#FF1C1C1E</color>
  <color name="t3w_text_secondary">#FF6E6E73</color>
  <color name="t3w_control">#FFE9E9EC</color>
  <color name="t3w_control_pressed">#FFDADADF</color>
  <color name="t3w_pressed">#14000000</color>
  <color name="t3w_accent">@color/t3w_text</color>
  <color name="t3w_on_accent">@color/t3w_surface</color>
  <!-- Gauge tracks are drawn into bitmaps in the app process, so they use one grey that reads on both cards. -->
  <color name="t3w_track">#4D8A8A8E</color>
  <color name="t3w_needs">#FFF59E0B</color>
  <color name="t3w_needs_text">#FFB45309</color>
  <color name="t3w_needs_fill">#26F59E0B</color>
  <color name="t3w_working">#FF3B82F6</color>
  <color name="t3w_failed">#FFEF4444</color>
  <color name="t3w_done">#FF22C55E</color>
  <color name="t3w_idle">#FF9CA3AF</color>
  <color name="t3w_clear_text">#FFFFFFFF</color>
  <color name="t3w_clear_text_secondary">#E6FFFFFF</color>
  <color name="t3w_clear_shadow">#80000000</color>
  <color name="t3w_clear_control">#40FFFFFF</color>
  <color name="t3w_clear_control_pressed">#66FFFFFF</color>
  <color name="t3w_clear_on_primary">#FF000000</color>
</resources>
